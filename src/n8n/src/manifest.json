{
  "name": "n8n",
  "version": "1.4.4",
  "title": "n8n",
  "description": "Workflow automation tool",
  "icon": "https://raw.githubusercontent.com/try-hola/apps/main/icons/n8n.svg",
  "ingress": {
    "service": "n8n",
    "port": 5678
  },
  "defaultEnv": [],
  "defaults": {
    "ports": [
      {
        "container": 5678,
        "protocol": "tcp"
      }
    ],
    "volumes": [
      {
        "containerPath": "/home/node/.n8n"
      }
    ]
  },
  "auth": {
    "mode": "none"
  },
  "upgrade": {
    "breaking": false,
    "preUpgradeBackup": "recommended",
    "upgradeNotesUrl": "https://github.com/n8n-io/n8n/releases"
  },
  "accepts": ["backup@1"]
}
